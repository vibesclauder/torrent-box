{
    "dht-enabled": false,
    "download-dir": "@DOWNLOAD_DIR@",
    "incomplete-dir": "@INCOMPLETE_DIR@",
    "incomplete-dir-enabled": true,
    "lpd-enabled": false,
    "peer-port": 51413,
    "pex-enabled": false,
    "port-forwarding-enabled": true,
