    "rpc-password": "@RPC_PASSWORD@",
    "rpc-port": 9091,
    "rpc-username": "@RPC_USER@",
    "rpc-whitelist": "127.0.0.1,@RPC_WHITELIST@",
    "rpc-whitelist-enabled": true,
    "script-torrent-done-enabled": false,
    "umask": 2
}
